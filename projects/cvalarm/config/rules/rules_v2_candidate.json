{
  "ruleset_id": "rules_v2_candidate",
  "version_label": "v2-reflection",
  "created_at": "2026-02-11T00:00:00+00:00",
  "description": "由人工驳回反馈离线反思生成的候选规则集：新增反光/阴影伪目标抑制，其余沿用 v1。",
  "policy": {
    "default_action": "escalate",
    "note": "结论由 priority 唯一决定：安全/可见性规则(200) > 授权抑制(150) > 告警(70-80) > 兜底(10)；平级时 suppress > escalate > alarm。"
  },
  "rules": [
    {
      "rule_id": "R-SAFETY-VISIBILITY",
      "event_classes": [
        "*"
      ],
      "description": "可见性不足时不得静默抑制，转人工复核。",
      "when": {
        "any": [
          {
            "field": "visibility_ok",
            "op": "==",
            "value": false
          }
        ]
      },
      "action": "escalate",
      "priority": 200,
      "severity": "medium",
      "norm_ref": "《安全技术防范系统运行维护规范》§6.1 复核要求"
    },
    {
      "rule_id": "R-SUPPRESS-AUTHORIZED",
      "event_classes": [
        "UNAUTHORIZED_INTRUSION",
        "UNAUTHORIZED_DWELL",
        "LOITERING",
        "RESTRICTED_AREA_ACTIVITY"
      ],
      "description": "作业许可覆盖该时段时抑制告警并留档。",
      "when": {
        "all": [
          {
            "field": "authorized",
            "op": "==",
            "value": true
          }
        ]
      },
      "action": "suppress",
      "priority": 150,
      "severity": "info",
      "norm_ref": "《厂区作业许可管理办法》§3.4",
      "require_authorization": [
        "work_permit"
      ]
    },
    {
      "rule_id": "R-SUPPRESS-REFLECTION",
      "event_classes": [
        "UNAUTHORIZED_INTRUSION",
        "RESTRICTED_AREA_ACTIVITY",
        "LOITERING"
      ],
      "description": "反馈聚类显示：低检测分 + 低运动能量 + 短时滞留多为反光或阴影伪目标，予以抑制并留档待抽检。",
      "when": {
        "all": [
          {
            "field": "mean_det_score",
            "op": "<",
            "value": 0.62
          },
          {
            "field": "motion_energy",
            "op": "<",
            "value": 0.15
          },
          {
            "field": "dwell_seconds",
            "op": "<",
            "value": 300
          }
        ]
      },
      "action": "suppress",
      "priority": 140,
      "severity": "info",
      "norm_ref": "《监控误报治理指引》§4.2（反光类伪目标）"
    },
    {
      "rule_id": "R-INTRUSION-A",
      "event_classes": [
        "UNAUTHORIZED_INTRUSION"
      ],
      "description": "周界防区 ROI-A 内滞留达到 45 秒。",
      "when": {
        "all": [
          {
            "field": "in_roi",
            "op": "==",
            "value": true
          },
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-A"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 45
          }
        ]
      },
      "action": "alarm",
      "priority": 80,
      "severity": "high",
      "norm_ref": "《厂区周界与重点区域安全管理细则》§5.2"
    },
    {
      "rule_id": "R-RESTRICTED-C",
      "event_classes": [
        "RESTRICTED_AREA_ACTIVITY"
      ],
      "description": "装卸通道 ROI-C 内滞留达到 45 秒。",
      "when": {
        "all": [
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-C"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 45
          }
        ]
      },
      "action": "alarm",
      "priority": 80,
      "severity": "high",
      "norm_ref": "《装卸作业区通行管理规定》§4.1"
    },
    {
      "rule_id": "R-LOITER-B",
      "event_classes": [
        "LOITERING"
      ],
      "description": "装卸区 ROI-B 内连续滞留达到 1800 秒。",
      "when": {
        "all": [
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-B"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 1800
          }
        ]
      },
      "action": "alarm",
      "priority": 70,
      "severity": "high",
      "norm_ref": "《厂区重点部位滞留时间管理规定》§2.3"
    },
    {
      "rule_id": "R-DWELL-D",
      "event_classes": [
        "UNAUTHORIZED_DWELL"
      ],
      "description": "重点区域 ROI-D 内停留达到 300 秒（首版两类事件之一）。",
      "when": {
        "all": [
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-D"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 300
          }
        ]
      },
      "action": "alarm",
      "priority": 75,
      "severity": "high",
      "norm_ref": "《重点区域停留时间管理规定》§2.1"
    },
    {
      "rule_id": "R-UNKNOWN-REVIEW",
      "event_classes": [
        "UNKNOWN_ANOMALY"
      ],
      "description": "未归类异常不自动确证，一律转人工复核。",
      "when": {
        "all": []
      },
      "action": "escalate",
      "priority": 10,
      "severity": "low",
      "norm_ref": "《异常事件分级处置办法》§5.1"
    }
  ]
}
