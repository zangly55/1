{
  "ruleset_id": "rules_v1",
  "version_label": "v1-baseline",
  "created_at": "2026-01-05T00:00:00+00:00",
  "description": "基线规则集：以肉眼可见的滞留事实 + 外部授权记录判定是否告警。",
  "policy": {
    "default_action": "escalate",
    "note": "结论由 priority 唯一决定：安全/可见性规则(200) > 授权抑制(150) > 告警(70-80) > 兜底(10)；平级时 suppress > escalate > alarm。"
  },
  "rules": [
    {
      "rule_id": "R-SAFETY-VISIBILITY",
      "event_classes": [
        "*"
      ],
      "description": "可见性不足（夜间低信噪比、强遮挡）时不得静默抑制，转人工复核。",
      "when": {
        "any": [
          {
            "field": "visibility_ok",
            "op": "==",
            "value": false
          }
        ]
      },
      "action": "escalate",
      "priority": 200,
      "severity": "medium",
      "norm_ref": "《安全技术防范系统运行维护规范》§6.1 复核要求"
    },
    {
      "rule_id": "R-SUPPRESS-AUTHORIZED",
      "event_classes": [
        "UNAUTHORIZED_INTRUSION",
        "UNAUTHORIZED_DWELL",
        "LOITERING",
        "RESTRICTED_AREA_ACTIVITY"
      ],
      "description": "外部作业许可记录覆盖该摄像头、该区域与告警时段时，滞留事实成立但不构成违规，予以抑制并留档。",
      "when": {
        "all": [
          {
            "field": "authorized",
            "op": "==",
            "value": true
          }
        ]
      },
      "action": "suppress",
      "priority": 150,
      "severity": "info",
      "norm_ref": "《厂区作业许可管理办法》§3.4",
      "require_authorization": [
        "work_permit"
      ]
    },
    {
      "rule_id": "R-INTRUSION-A",
      "event_classes": [
        "UNAUTHORIZED_INTRUSION"
      ],
      "description": "周界防区 ROI-A 内滞留达到 45 秒，判定为未授权进入。",
      "when": {
        "all": [
          {
            "field": "in_roi",
            "op": "==",
            "value": true
          },
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-A"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 45
          }
        ]
      },
      "action": "alarm",
      "priority": 80,
      "severity": "high",
      "norm_ref": "《厂区周界与重点区域安全管理细则》§5.2"
    },
    {
      "rule_id": "R-RESTRICTED-C",
      "event_classes": [
        "RESTRICTED_AREA_ACTIVITY"
      ],
      "description": "装卸通道 ROI-C 内滞留达到 45 秒即触发限制区域活动告警。",
      "when": {
        "all": [
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-C"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 45
          }
        ]
      },
      "action": "alarm",
      "priority": 80,
      "severity": "high",
      "norm_ref": "《装卸作业区通行管理规定》§4.1"
    },
    {
      "rule_id": "R-LOITER-B",
      "event_classes": [
        "LOITERING"
      ],
      "description": "装卸区 ROI-B 内连续滞留达到 1800 秒判定为长时间滞留。",
      "when": {
        "all": [
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-B"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 1800
          }
        ]
      },
      "action": "alarm",
      "priority": 70,
      "severity": "high",
      "norm_ref": "《厂区重点部位滞留时间管理规定》§2.3"
    },
    {
      "rule_id": "R-DWELL-D",
      "event_classes": [
        "UNAUTHORIZED_DWELL"
      ],
      "description": "重点区域 ROI-D 内停留达到 300 秒（首版两类事件之一）。",
      "when": {
        "all": [
          {
            "field": "roi_id",
            "op": "in",
            "value": [
              "ROI-D"
            ]
          },
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 300
          }
        ]
      },
      "action": "alarm",
      "priority": 75,
      "severity": "high",
      "norm_ref": "《重点区域停留时间管理规定》§2.1"
    },
    {
      "rule_id": "R-OBJECT-ABANDONED",
      "event_classes": [
        "OBJECT_ABANDONED"
      ],
      "description": "静止目标在防区内留存达到 120 秒判定为遗留物品。",
      "when": {
        "all": [
          {
            "field": "dwell_seconds",
            "op": ">=",
            "value": 120
          }
        ]
      },
      "action": "alarm",
      "priority": 70,
      "severity": "medium",
      "norm_ref": "《重点目标遗留物处置流程》§3.2"
    },
    {
      "rule_id": "R-UNKNOWN-REVIEW",
      "event_classes": [
        "UNKNOWN_ANOMALY"
      ],
      "description": "未归类异常不自动确证，一律转人工复核。",
      "when": {
        "all": []
      },
      "action": "escalate",
      "priority": 10,
      "severity": "low",
      "norm_ref": "《异常事件分级处置办法》§5.1"
    }
  ]
}
